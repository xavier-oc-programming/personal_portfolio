{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Current Python File (.venv)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["${file}"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    },
    {
      "label": "Run Current Python File (VS Code Interpreter)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["${file}"],
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    }
  ]
}
