FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here
ADMIN_PASSWORD=your-admin-password

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false

MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

MAIL_DEFAULT_SENDER=your-email@example.com
CONTACT_NOTIFICATION_EMAIL=your-email@example.com

SITE_URL=http://127.0.0.1:5000
SITE_NAME=Xavier OC | Dev Portfolio
DEFAULT_META_DESCRIPTION=Your meta description here.
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

GOOGLE_API_KEY=your-google-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
RESEND_API_KEY=your-resend-api-key-here

# Production database (PostgreSQL). Leave blank to use local SQLite.
DATABASE_URL=postgresql://user:password@host:port/dbname

GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=your-username/your-repo

# Cloudflare R2 — used for project image storage (card images, screenshots, videos).
# Create a bucket at dash.cloudflare.com → R2, then generate an Account API Token
# with Object Read & Write permission scoped to your bucket.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<id>.r2.dev
